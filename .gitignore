# 🛒 MultiShop - Plataforma E-commerce MVC
# Archivo .gitignore para proyecto PHP con arquitectura MVC

# ================================
# 🔧 ARCHIVOS DE CONFIGURACIÓN
# ================================

# Configuración de base de datos (credenciales sensibles)
config/database.php
config/app.php
.env
.env.local
.env.production

# Archivos de configuración del servidor
.htaccess.local
php.ini

# ================================
# 📁 DIRECTORIOS DEL SISTEMA
# ================================

# Archivos de sistema Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Archivos de sistema macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Archivos de sistema Linux
*~
.directory

# ================================
# 💻 ENTORNOS DE DESARROLLO
# ================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PhpStorm / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# NetBeans
nbproject/
build/
nbbuild/
dist/
nbdist/

# Eclipse
.project
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath

# ================================
# 🗃️ BASES DE DATOS Y LOGS
# ================================

# Archivos de base de datos SQLite
*.sqlite
*.sqlite3
*.db

# Dumps de base de datos
*.sql
!database/schema.sql
!database/migrations/*.sql

# Logs del servidor
logs/
*.log
error.log
access.log
php_errors.log

# ================================
# 📦 DEPENDENCIAS Y PAQUETES
# ================================

# Composer (si se usa en el futuro)
vendor/
composer.lock
composer.phar

# Node.js (si se agrega en el futuro)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bower
bower_components/

# ================================
# 🗂️ ARCHIVOS TEMPORALES
# ================================

# Archivos temporales de PHP
*.tmp
*.temp
/tmp/
temp/

# Cache del sistema
cache/
*.cache

# Sesiones PHP
/sessions/
session_*

# Archivos de respaldo
*.bak
*.backup
*.old
*~

# ================================
# 📤 ARCHIVOS DE SUBIDA
# ================================

# Directorio de uploads (imágenes subidas por usuarios)
public/uploads/
uploads/
!public/uploads/.gitkeep

# Archivos de imágenes temporales
public/img/temp/
public/img/cache/

